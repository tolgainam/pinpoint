{
  "manifest_version": 3,
  "name": "Pinpoint",
  "version": "0.4.5",
  "description": "Pin comments to elements on a local dev page and dispatch them into a running Claude Code session.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>", "http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js" },
  "options_page": "welcome.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Pinpoint — show or hide toolbar",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "commands": {
    "freeze": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Freeze the page and pin what is on screen"
    },
    "focus-pinpoint": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Show the Pinpoint toolbar and move the keyboard to it"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["probe.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["status.js", "a11y.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tokens.css", "overlay.css", "icons/icon-48.png"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://*/*", "https://*/*"]
    }
  ]
}
